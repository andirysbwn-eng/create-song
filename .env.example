# Wajib di Vercel dan lokal: rahasia acak panjang untuk menandatangani sesi login
SESSION_SECRET=ganti_dengan_random_secret_panjang

# Contoh akun Aisyah. Tambahkan satu blok serupa untuk setiap pengguna.
AISYAH_USERNAME=aisyah
AISYAH_PASSWORD=ganti_password_kuat
AISYAH_API_KEY_1=isi_api_key_aisyah_1
AISYAH_API_KEY_2=isi_api_key_aisyah_2

# Contoh akun Budi
BUDI_USERNAME=budi
BUDI_PASSWORD=ganti_password_kuat_lain
BUDI_API_KEY_1=isi_api_key_budi_1
BUDI_API_KEY_2=isi_api_key_budi_2
